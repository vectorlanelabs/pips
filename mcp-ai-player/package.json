{
  "name": "@pips/mcp-ai-player",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent join a live Pips Farkle room as a real player, over the same PeerJS protocol a human browser client uses.",
  "type": "module",
  "bin": {
    "mcp-ai-player": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b --noEmit && node esbuild.config.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-datachannel": "^0.10.0",
    "peerjs": "^1.5.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0",
    "typescript": "~6.0.2"
  }
}
